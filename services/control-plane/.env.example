# --- Control plane env (copy to .env) ---
# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cascade
# Auth
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=2592000
# Server
PORT=8080
LOG_LEVEL=info
# Stripe (M1) — test mode placeholder keys. Replace with your own sk_test_... and whsec_...
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me
# Stripe price IDs (create products in Stripe dashboard, then set these)
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
# Web URL for checkout redirects
WEB_URL=http://localhost:3000
# Twilio (M4)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
