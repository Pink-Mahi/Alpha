# Control Plane environment variables

# --- Server ---
PORT=8080
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgres://ALPHA:ALPHA@localhost:5432/ALPHA

# --- Auth ---
JWT_SECRET=change-me-to-a-random-32-byte-string

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Connect (marketplace payouts) — M4
STRIPE_CLIENT_ID=ca_xxx

# --- LLM Providers (BYO-key, but control plane needs fallback) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Rate Limiting ---
# Set to "1" to disable rate limiting (test mode only)
RATE_LIMIT_DISABLED=0
