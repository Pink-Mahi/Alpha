{
  "name": "ALPHA-agent",
  "displayName": "ALPHA Agent",
  "description": "Agentic coding command center — plan, execute, review multi-file tasks with autonomous agents.",
  "version": "0.0.0",
  "publisher": "dev.ALPHA",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": ["Other", "Machine Learning", "Chat"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ALPHA",
          "title": "ALPHA",
          "icon": "media/ALPHA-icon.svg"
        }
      ]
    },
    "views": {
      "ALPHA": [
        {
          "id": "ALPHA.commandCenter",
          "name": "Command Center",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "ALPHA.newTask",
        "title": "ALPHA: New Task",
        "category": "ALPHA"
      },
      {
        "command": "ALPHA.openCommandCenter",
        "title": "ALPHA: Open Command Center",
        "category": "ALPHA"
      },
      {
        "command": "ALPHA.pauseAgent",
        "title": "ALPHA: Pause Agent",
        "category": "ALPHA"
      },
      {
        "command": "ALPHA.killAgent",
        "title": "ALPHA: Kill Agent",
        "category": "ALPHA"
      },
      {
        "command": "ALPHA.signIn",
        "title": "ALPHA: Sign In",
        "category": "ALPHA"
      }
    ],
    "configuration": {
      "title": "ALPHA",
      "properties": {
        "ALPHA.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "ALPHA control plane URL."
        },
        "ALPHA.agentRuntimeUrl": {
          "type": "string",
          "default": "http://localhost:8083",
          "description": "ALPHA local agent runtime URL."
        },
        "ALPHA.apiKey": {
          "type": "string",
          "default": "",
          "description": "ALPHA API key (or use the Sign In command)."
        },
        "ALPHA.defaultRuntime": {
          "type": "string",
          "enum": ["local", "cloud"],
          "default": "local",
          "description": "Default agent runtime for new tasks."
        },
        "ALPHA.budgetUSD": {
          "type": "number",
          "default": 2.0,
          "description": "Default per-task budget cap in USD."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "ALPHA.newTask",
          "when": "ALPHA.signedIn"
        },
        {
          "command": "ALPHA.pauseAgent",
          "when": "ALPHA.agentRunning"
        },
        {
          "command": "ALPHA.killAgent",
          "when": "ALPHA.agentRunning"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -p ./tsconfig.json --watch",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
